# Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_api_key_here

# Model to use. Older models get deprecated over time — if you see a
# 404 "no longer available" error, run `python3 test_gemini.py` to list
# the models available to your API key and update this value.
MODEL_NAME=gemini-3.5-flash

# Maximum number of retries for LLM JSON formatting errors
MAX_RETRIES=3
